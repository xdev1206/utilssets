config_list=$(ls ${ENV_PATH}/config)

echo "shell is: ${SHELL}"

if [[ ${SHELL} =~ .*zsh ]]; then
    for config in ${(f)config_list}
    do
        echo "import config: ${ENV_PATH}/config/${config}"
        source $ENV_PATH/config/${config}
    done
else
    for config in ${config_list}
    do
        echo "import config: ${ENV_PATH}/config/${config}"
        source $ENV_PATH/config/${config}
    done
fi
